// Builtin higher-order array methods (map, filter) with lambdas calling back into Evie.
// expect: 1195804800
package main

fn main() {
    var data := []
    var i := 0
    while i < 1000 {
        data.push(i)
        i += 1
    }

    var total := 0
    var r := 0
    while r < 1200 {
        evens := data.filter(fn(x) => x % 2 == 0)
        squares := evens.map(fn(x) => x * x)
        total += squares.len() + squares[-1]
        r += 1
    }
    return total
}
