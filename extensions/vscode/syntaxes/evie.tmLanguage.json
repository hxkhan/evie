{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Evie",
	"scopeName": "source.ev",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#block_comment"
		},
		{
			"include": "#template_literals"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#calls"
		},
		{
			"include": "#numeric_literals"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"declarations": {
			"patterns": [
				{
					"comment": "Function definitions with parameters",
					"match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)",
					"captures": {
						"1": {
							"name": "keyword.declaration.function.evie"
						},
						"2": {
							"name": "entity.name.function.definition.evie"
						},
						"3": {
							"patterns": [
								{
									"match": "\\.\\.\\.",
									"name": "keyword.operator.variadic.evie"
								},
								{
									"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
									"name": "variable.parameter.evie"
								}
							]
						}
					}
				},
				{
					"comment": "Class definitions with fields and optional inheritance",
					"match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)(?:\\s*:\\s*([A-Za-z_][A-Za-z0-9_]*))?",
					"captures": {
						"1": {
							"name": "keyword.declaration.class.evie"
						},
						"2": {
							"name": "entity.name.type.class.evie"
						},
						"3": {
							"patterns": [
								{
									"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
									"name": "variable.parameter.evie"
								}
							]
						},
						"4": {
							"name": "entity.other.inherited-class.evie"
						}
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"comment": "Await and variants",
					"name": "keyword.control.await.evie",
					"match": "\\bawait(\\.(all|any|race|timeout))?\\b"
				},
				{
					"comment": "Control flow keywords",
					"name": "keyword.control.evie",
					"match": "\\b(if|else|while|for|in|continue|break|return|switch|case|default|throw|is|catch|go)\\b"
				},
				{
					"comment": "Declaration keywords",
					"name": "keyword.declaration.evie",
					"match": "\\b(package|imports|var|const|fn|class)\\b"
				},
				{
					"comment": "Language receiver variables",
					"name": "variable.language.evie",
					"match": "\\b(this|super)\\b"
				},
				{
					"comment": "Other keywords",
					"name": "keyword.other.evie",
					"match": "\\b(echo)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"comment": "Built-in types",
					"match": "\\b(number|bool|string|buffer|array|object|task|error)\\b",
					"name": "entity.name.type.evie"
				}
			]
		},
		"calls": {
			"patterns": [
				{
					"comment": "Method calls (.method())",
					"match": "\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.method.evie"
						}
					}
				},
				{
					"comment": "Function calls",
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.call.evie"
						}
					}
				}
			]
		},
		"template_literals": {
			"name": "string.template.evie",
			"begin": "`",
			"end": "`",
			"patterns": [
				{
					"name": "constant.character.escape.evie",
					"match": "\\\\([\"`\\\\ntr0{}])"
				},
				{
					"name": "invalid.illegal.escape.evie",
					"match": "\\\\."
				},
				{
					"name": "meta.template.expression.evie",
					"begin": "\\{",
					"end": "\\}",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.template-expression.begin.evie"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.template-expression.end.evie"
						}
					},
					"patterns": [
						{
							"include": "#template_braces"
						},
						{
							"include": "#comments"
						},
						{
							"include": "#block_comment"
						},
						{
							"include": "#template_literals"
						},
						{
							"include": "#strings"
						},
						{
							"include": "#declarations"
						},
						{
							"include": "#keywords"
						},
						{
							"include": "#types"
						},
						{
							"include": "#constants"
						},
						{
							"include": "#calls"
						},
						{
							"include": "#numeric_literals"
						},
						{
							"include": "#operators"
						},
						{
							"include": "#identifiers"
						}
					]
				}
			]
		},
		"template_braces": {
			"begin": "\\{",
			"end": "\\}",
			"patterns": [
				{
					"include": "#template_braces"
				},
				{
					"include": "#comments"
				},
				{
					"include": "#block_comment"
				},
				{
					"include": "#template_literals"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#declarations"
				},
				{
					"include": "#keywords"
				},
				{
					"include": "#types"
				},
				{
					"include": "#constants"
				},
				{
					"include": "#calls"
				},
				{
					"include": "#numeric_literals"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#identifiers"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"comment": "Arrow function operator",
					"name": "storage.type.function.arrow.evie",
					"match": "=>"
				},
				{
					"comment": "Variadic operator",
					"name": "keyword.operator.variadic.evie",
					"match": "\\.\\.\\."
				},
				{
					"comment": "Logical operators",
					"name": "keyword.operator.logical.evie",
					"match": "(&&|\\|\\||!)"
				},
				{
					"comment": "Comparison operators",
					"name": "keyword.operator.comparison.evie",
					"match": "(==|!=|<=|>=|<|>)"
				},
				{
					"comment": "Assignment operators",
					"name": "keyword.operator.assignment.evie",
					"match": "(\\+=|-=|/=|\\*=|%=|:=|=)"
				},
				{
					"comment": "Arithmetic operators",
					"name": "keyword.operator.arithmetic.evie",
					"match": "(\\+|-|/|\\*|%)"
				},
				{
					"comment": "Field existence operator",
					"name": "keyword.operator.existence.evie",
					"match": "\\?"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"comment": "Boolean constants",
					"name": "constant.language.boolean.evie",
					"match": "\\b(true|false)\\b"
				},
				{
					"comment": "Nil constant",
					"name": "constant.language.null.evie",
					"match": "\\b(nil)\\b"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"comment": "Variable identifiers",
					"name": "variable.other.evie",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"comment": "Double-quoted strings",
					"name": "string.quoted.double.evie",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.evie",
							"match": "\\\\([\"\\\\ntr0])"
						},
						{
							"name": "invalid.illegal.escape.evie",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"comment": "Line comments",
					"name": "comment.line.double-slash.evie",
					"begin": "//",
					"end": "$",
					"patterns": [
						{
							"name": "meta.toc-list.banner.evie",
							"match": "\\b(TODO|FIXME|NOTE|BUG|HACK)\\b:?"
						}
					]
				}
			]
		},
		"block_comment": {
			"patterns": [
				{
					"comment": "Block comments",
					"name": "comment.block.evie",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{
							"name": "meta.toc-list.banner.evie",
							"match": "\\b(TODO|FIXME|NOTE|BUG|HACK)\\b:?"
						}
					]
				}
			]
		},
		"numeric_literals": {
			"patterns": [
				{
					"comment": "Floating-point literals",
					"name": "constant.numeric.float.evie",
					"match": "\\b\\d+\\.\\d+\\b"
				},
				{
					"comment": "Integer literals",
					"name": "constant.numeric.integer.evie",
					"match": "\\b\\d+\\b"
				}
			]
		}
	}
}
