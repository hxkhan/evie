package main

struct vec2(x, y) {
    @add(a, b) => vec2{x: a.x+b.x, y: a.y+b.y}
}

struct vec2(x, y) {
    @add(rhs) => vec2{x: x+rhs.x, y: y+b.y}

    @string => `vec({x}, {y})`
}

struct animal() {
    fn eat(food) {

    }
}

struct dog() {
    @index(what) => animal[what]
}

struct error(kind, message) {
    fn wrap(a) {
        
    }
}

struct string(value) {
    fn split(delimiter) {

    }
}

struct person(name, age) {
    if !(name is string) {
        throw error("TypeError", "a person's name must be a string")
    }

    fn eat(x) {

    }
}

record color(r, g, b) {
    @constructor(this) {
        if this.r < 0 || this.g > 255 || this.g < 0 || this.r > 255 || this.b < 0 || this.b > 255 {
            throw "rgb values need to be between 0 and 255"
        }
    }

    @equals(rhs) => this.r == rhs.r && this.g == rhs.g && this.b == rhs.b

    black := fn() => color(0, 0, 0)
    white := color(255, 255, 255)

    darken(this, percentage) {
        factor := 1.0 - percentage
        return color(
            Math.max(0, this.r * factor),
            Math.max(0, this.g * factor),
            Math.max(0, this.b * factor)
        )
    }
}

// so all functions need to be marked: takesSelf = true/false
// then doing a dot-access on the type will return Method{this: nil, fn(this, ...)}
// and doing a dot-access on the value will return Method{this: value, fn(this, ...)}

color.darken == darken(this, ...)
color.white.darken == BoundedMethod{this: color.white, darken(this, ...)}

fn main() {
    c1 := error {
        kind: "NetworkError",
        message: "TCP connection could not be established",
        // more meta-deta can be optionally added like
        something: 10 
    }

    c2 := error({ kind: "NetworkError", message: "TCP connection could not be established"})

    c3 := error("NetworkError", "TCP connection could not be established")
}
