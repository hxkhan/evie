package main imports("io")

fn divide(a, b) {
    if b == 0 {
        throw "division by zero"
    }
    return a / b
}

fn main() {
    // 1. Runtime error caught by catch
    b := catch(5 + "10")
    if b is error {
        io.println("Caught runtime error: " + b.message)
    }

    // 2. User-thrown error via throw statement
    ok := divide(10, 2)
    io.println(ok)

    res := catch(divide(10, 0))
    if res is error {
        io.println("Caught custom throw: " + res.message)
    }

    // 3. Error constructor
    custom := error("constructed error")
    if custom is error {
        io.println("Error constructor works: " + custom.string())
    }
}