package main

fn sieve(n) {
	var flags := []
	var i := 0
	while i < n {
		flags.push(0)
		i += 1
	}

	i = 2
	while i * i < n {
		if flags[i] == 0 {
			var j := i * i
			while j < n {
				flags[j] = 1
				j += i
			}
		}
		i += 1
	}

	var count := 0
	i = 2
	while i < n {
		if flags[i] == 0 {
			count += 1
		}
		i += 1
	}
	return count
}

fn main() => sieve(1000000)
