package main imports("strings")

fn main() {
	base := "alpha,beta,gamma,delta,epsilon"
	var total := 0
	var i := 0
	while i < 40000 {
		s := base + "," + string(i)
		parts := s.split(",")
		joined := parts.join("-")
		replaced := strings.replace(joined, "beta", "BETA")
		if replaced.contains("gamma") {
			total += replaced.len()
		}
		i += 1
	}
	return total
}
