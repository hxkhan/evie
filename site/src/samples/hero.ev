package main imports("io")

class Account(owner) {
    var balance := 0

    fn deposit(amount) {
        this.balance += amount
    }

    fn withdraw(amount) {
        if amount > this.balance {
            throw error("not enough money")
        }
        this.balance -= amount
    }
}

fn main() {
    account := Account("Ada")
    account.deposit(100)
    account.withdraw(30)
    io.println(`{account.owner} has {account.balance} left`)
}
