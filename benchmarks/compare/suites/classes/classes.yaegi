package main

import "fmt"

type item interface {
	compute(x int) int
}

type adder struct{ base, step int }

func (a *adder) adjust(x int) int {
	a.base = (a.base + a.step) % 1000
	return a.base + x
}

func (a *adder) compute(x int) int { return a.adjust(x) + a.step }

type scaler struct{ base, factor int }

func (s *scaler) adjust(x int) int {
	s.base = (s.base + x) % 1000
	return s.base * s.factor
}

func (s *scaler) compute(x int) int { return s.adjust(x) - s.factor }

// The constructors return the interface. Yaegi v0.16.3 has a bug in which a
// loop that appends pointers to a slice of interfaces keeps reusing one
// interface value, so every element ends up the last object; converting in a
// function avoids it. Go itself runs either form correctly.
func newAdder(base, step int) item    { return &adder{base, step} }
func newScaler(base, factor int) item { return &scaler{base, factor} }

func main() {
	var items []item
	for i := 0; i < 200; i++ {
		if i%2 == 0 {
			items = append(items, newAdder(i, i%7+1))
		} else {
			items = append(items, newScaler(i, i%5+1))
		}
	}

	total := 0
	for r := 0; r < 2000; r++ {
		x := r % 13
		for _, it := range items {
			total += it.compute(x)
		}
	}
	fmt.Println(total)
}
