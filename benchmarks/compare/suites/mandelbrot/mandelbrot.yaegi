package main

import "fmt"

func mandelbrot(size, maxIter int) int {
	total := 0
	for py := 0; py < size; py++ {
		y0 := (float64(py)/float64(size))*2.0 - 1.0
		for px := 0; px < size; px++ {
			x0 := (float64(px)/float64(size))*3.5 - 2.5
			x, y := 0.0, 0.0
			iter := 0
			for iter < maxIter {
				xx := x * x
				yy := y * y
				if xx+yy > 4.0 {
					break
				}
				y = 2.0*x*y + y0
				x = xx - yy + x0
				iter++
			}
			total += iter
		}
	}
	return total
}

func main() {
	fmt.Println(mandelbrot(400, 50))
}
