package main

import (
	"fmt"
	"strconv"
	"strings"
)

func main() {
	base := "alpha,beta,gamma,delta,epsilon"
	total := 0
	for i := 0; i < 40000; i++ {
		s := base + "," + strconv.Itoa(i)
		parts := strings.Split(s, ",")
		joined := strings.Join(parts, "-")
		replaced := strings.ReplaceAll(joined, "beta", "BETA")
		if strings.Contains(replaced, "gamma") {
			total += len(replaced)
		}
	}
	fmt.Println(total)
}
