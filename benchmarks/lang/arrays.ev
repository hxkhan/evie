// Array operations: push/pop, indexed reads/writes, negative indexing, len, slice, reverse, contains.
// expect: 101443850
package main

fn main() {
    var total := 0

    // stack-like push/pop churn
    var stack := []
    var r := 0
    while r < 200 {
        var i := 0
        while i < 1000 {
            stack.push(i)
            i += 1
        }
        while stack.len() > 0 {
            total += stack.pop()
        }
        r += 1
    }

    // indexed read-modify-write
    var arr := []
    var i := 0
    while i < 1000 {
        arr.push(i)
        i += 1
    }
    r = 0
    while r < 300 {
        i = 0
        while i < 1000 {
            arr[i] = arr[i] + 1
            i += 1
        }
        total += arr[-1]
        r += 1
    }

    // builtin methods
    r = 0
    while r < 2000 {
        part := arr.slice(100, 200)
        rev := part.reverse()
        total += rev[0] + part.len()
        if arr.contains(r) {
            total += 1
        }
        r += 1
    }
    return total
}
