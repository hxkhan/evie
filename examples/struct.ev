package main

struct person(name, age) {
    fn greet(prefix) {
        return prefix + ", I am " + this.name
    }

    fn haveBirthday() {
        this.age = this.age + 1
    }
}

fn main() {
    echo person

    p := person("John", 22)
    p.email = "john03@gmail.com" // optional fields can be added

    if p is person {
        echo "p is definitely a person"
    }

    echo p.greet("Hello")
    p.haveBirthday()
    echo p
}