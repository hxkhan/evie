package main imports("io", "math")

// convert turns a temperature such as 21C or 70F into the other scale
fn convert(text) {
    unit := text.slice(-1).toUpper()
    if unit != "C" && unit != "F" {
        throw error(`'{text}' needs a C or an F at the end`)
    }
    value := catch(number(text.slice(0, -1)))
    if value is error {
        throw error(`'{text}' is not a temperature`)
    }
    if unit == "C" {
        return `{text} is {math.round(value * 9 / 5 + 32)}F`
    }
    return `{text} is {math.round((value - 32) * 5 / 9)}C`
}

fn main() {
    io.println("Type a temperature such as 21C or 70F, or nothing to stop.")
    var line := io.prompt("> ")
    while line != nil && line.trim() != "" {
        result := catch(convert(line.trim()))
        if result is error {
            io.println(result.message)
        } else {
            io.println(result)
        }
        line = io.prompt("> ")
    }
    io.println("Bye!")
}
