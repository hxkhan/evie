package main imports("strings")

// Compares a package function with the equivalent method.
// Swap the commented lines and time each with `evie -t examples/benchmark.ev`.
fn main() {
    var n := 1000000
    message := "hello world"
    while n > 0 {
        // parts := strings.split(message, " ")
        parts := message.split(" ")
        whole := parts.join("_")
        n -= 1
    }

    echo "done"
}
