package main imports("io", "math")

// Reads temperatures from the Input tab, such as 21C or 70F, and converts
// each to the other scale. Edit the input and run again.
fn convert(text) {
    unit := text.slice(-1).toUpper()
    if unit != "C" && unit != "F" {
        throw error(`'{text}' needs a C or an F at the end`)
    }
    value := catch(number(text.slice(0, -1)))
    if value is error {
        throw error(`'{text}' is not a temperature`)
    }
    if unit == "C" {
        return `{text} is {math.round(value * 9 / 5 + 32)}F`
    }
    return `{text} is {math.round((value - 32) * 5 / 9)}C`
}

fn main() {
    var line := io.readln()
    while line != nil {
        line = line.trim()
        if line != "" {
            result := catch(convert(line))
            if result is error {
                io.println(result.message)
            } else {
                io.println(result)
            }
        }
        line = io.readln()
    }
}
