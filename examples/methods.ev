package main

fn main() {
    message := "hello world"
    parts := message.split(" ")
    whole := parts.join("_")

    // hello world -> ["hello", "world"] -> hello_world
    echo `{message} -> {parts} -> {whole}`

    echo message.contains(" ")       // true
    echo message.endsWith("world")   // true
    echo message.startsWith("hello") // true

    echo "  ABC    ".trim() // ABC

    echo message.toUpper() // HELLO WORLD

    echo message.len() // 11
}