fmt = import("fmt")

makeAcc = func(start) {
	total = start
	return func(delta) {
		total += delta
		return total
	}
}

main = func() {
	sum = 0
	for i = 0; i < 50000; i++ {
		acc = makeAcc(i)
		acc(3)
		acc(7)
		sum += acc(-2)
	}

	big = makeAcc(0)
	for j = 0; j < 1000000; j++ {
		big(j % 7)
	}
	sum += big(0)
	return sum
}

fmt.println(main())
