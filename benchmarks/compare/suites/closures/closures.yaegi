package main

import "fmt"

func makeAcc(start int) func(int) int {
	total := start
	return func(delta int) int {
		total += delta
		return total
	}
}

func main() {
	sum := 0
	for i := 0; i < 50000; i++ {
		acc := makeAcc(i)
		acc(3)
		acc(7)
		sum += acc(-2)
	}

	big := makeAcc(0)
	for j := 0; j < 1000000; j++ {
		big(j % 7)
	}
	sum += big(0)
	fmt.Println(sum)
}
