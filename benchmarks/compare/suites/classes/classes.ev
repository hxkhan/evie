package main

class Adder(base, step) {
	fn adjust(x) {
		this.base = (this.base + this.step) % 1000
		return this.base + x
	}

	fn compute(x) => this.adjust(x) + this.step
}

class Scaler(base, factor) {
	fn adjust(x) {
		this.base = (this.base + x) % 1000
		return this.base * this.factor
	}

	fn compute(x) => this.adjust(x) - this.factor
}

fn main() {
	var items := []
	var i := 0
	while i < 200 {
		if i % 2 == 0 {
			items.push(Adder(i, (i % 7) + 1))
		} else {
			items.push(Scaler(i, (i % 5) + 1))
		}
		i += 1
	}

	var total := 0
	var r := 0
	while r < 2000 {
		x := r % 13
		for item in items {
			total += item.compute(x)
		}
		r += 1
	}
	return total
}
