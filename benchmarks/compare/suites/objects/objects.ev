package main

fn main() {
	var keys := []
	var i := 0
	while i < 500 {
		keys.push("k" + string(i))
		i += 1
	}

	var total := 0
	var r := 0
	while r < 400 {
		m := {}
		var j := 0
		while j < 500 {
			m[keys[j]] = j + r
			j += 1
		}
		j = 0
		while j < 500 {
			k := keys[j]
			m[k] = m[k] + (j % 5)
			j += 1
		}
		j = 0
		while j < 500 {
			total += m[keys[j]]
			j += 1
		}
		r += 1
	}
	return total
}
