fmt := import("fmt")
text := import("text")

main := func() {
	base := "alpha,beta,gamma,delta,epsilon"
	total := 0
	for i := 0; i < 40000; i++ {
		s := base + "," + string(i)
		parts := text.split(s, ",")
		joined := text.join(parts, "-")
		replaced := text.replace(joined, "beta", "BETA", -1)
		if text.contains(replaced, "gamma") {
			total += len(replaced)
		}
	}
	return total
}

fmt.println(main())
