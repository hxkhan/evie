package main imports("io")

var count := 0

fn main() {
    t1 := go incrementer(5000)
    t2 := go incrementer(5000)

    await.all(t1, t2)
    io.println(count) // always 10000: fibers of an instance never run at the same time
}

fn incrementer(times) {
    while times > 0 {
        count += 1
        times -= 1
    }
}