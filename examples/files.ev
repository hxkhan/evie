package main imports("fs", "io")

fn main() {
    version1()
}

fn version1() {
    fib := go fs.readFile("./examples/fib.ev")
    goEx := go fs.readFile("./examples/go.ev")

    io.println("fib.ev bytes:", (await fib).len())
    io.println("go.ev bytes:", (await goEx).len())
}

// slightly more efficient: overlap one read with the main fiber
fn version2() {
    fib := go fs.readFile("./examples/fib.ev")
    goEx := fs.readFile("./examples/go.ev")

    io.println("fib.ev bytes:", (await fib).len())
    io.println("go.ev bytes:", goEx.len())
}
