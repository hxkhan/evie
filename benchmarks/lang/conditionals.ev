// Branching: if/else-if chains, logical operators with short-circuiting, `is` checks, negation.
// expect: 2804754
package main

fn classify(n) {
    if n % 15 == 0 {
        return 4
    } else if n % 5 == 0 {
        return 3
    } else if n % 3 == 0 {
        return 2
    }
    return 1
}

fn main() {
    var total := 0
    var i := 0
    while i < 1000000 {
        total += classify(i)
        if i > 10 && i < 500000 || i % 7 == 0 {
            total += 1
        }
        if !(i % 2 == 0) && i is number {
            total += 1
        }
        i += 1
    }
    return total
}
