// Floating point heavy: count grid points inside the Mandelbrot set.
// expect: 24792
package main

fn main() {
    size := 250
    maxIter := 50
    var inside := 0
    var y := 0
    while y < size {
        ci := 2.0 * y / size - 1.0
        var x := 0
        while x < size {
            cr := 2.0 * x / size - 1.5
            var zr := 0.0
            var zi := 0.0
            var i := 0
            var escaped := false
            while i < maxIter {
                tr := zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = tr
                if zr * zr + zi * zi > 4.0 {
                    escaped = true
                    break
                }
                i += 1
            }
            if !escaped {
                inside += 1
            }
            x += 1
        }
        y += 1
    }
    return inside
}
