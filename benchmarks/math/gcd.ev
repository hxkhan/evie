// Iterative Euclid via modulo, summed over a grid.
// expect: 1494648
package main

fn gcd(a, b) {
    var x := a
    var y := b
    while y != 0 {
        t := x % y
        x = y
        y = t
    }
    return x
}

fn main() {
    var sum := 0
    var i := 1
    while i <= 600 {
        var j := 1
        while j <= 600 {
            sum += gcd(i, j)
            j += 1
        }
        i += 1
    }
    return sum
}
