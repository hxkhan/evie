{
  "name": "evie-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Evie's website: the language guide and a playground that runs Evie in the browser",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run wasm && npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-wasm.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@fontsource-variable/dm-sans": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "@fontsource-variable/source-serif-4": "^5.1.0",
    "@lezer/highlight": "^1.2.1",
    "marked": "^15.0.3"
  }
}
