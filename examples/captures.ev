package main imports("io")

fn main() {
    // 1 layer of capture
    var printer = single()
    printer()

    // 2 layers of capture
    let getter = double()
    printer = getter()
    printer()
}

fn single() {
    let message = "Hello World"

    // printer
    return fn() {
        io.println(message)
    }
}

fn double() {
    let message = "Bye World"

    // getter
    return fn() {
        // printer
        return fn() {
            io.println(message)
        }
    }
}
