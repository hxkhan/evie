// Recursive Euclid: call-heavy integer math.
// expect: 1494648
package main

fn gcd(a, b) {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn main() {
    var sum := 0
    var i := 1
    while i <= 600 {
        var j := 1
        while j <= 600 {
            sum += gcd(i, j)
            j += 1
        }
        i += 1
    }
    return sum
}
