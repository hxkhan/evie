package main

fn main() {
    message := "Lorem ipsum dolor sit amet"

    echo message.split(" ")           // ["Lorem", "ipsum", "dolor", "sit", "amet"]
    echo message.split(" ").join("_") // Lorem_ipsum_dolor_sit_amet

    echo "---"

    echo message.startsWith("Lorem") // true
    echo message.endsWith("amet")    // true
    echo message.contains("dolor")   // true

    echo "---"

    echo message.toUpper() // LOREM IPSUM DOLOR SIT AMET
    echo message.len()     // 26

    echo "---"

    echo message.len // <method>
    echo string.len  // <method>

    parts := message.split(" ")
    echo parts.map(fn(v) => v.toUpper()) // ["LOREM", "IPSUM", "DOLOR", "SIT", "AMET"]
    echo parts.map(string.toUpper)       // ["LOREM", "IPSUM", "DOLOR", "SIT", "AMET"]
    echo parts.map(string.len)           // [5, 5, 5, 3, 4]
}


// "john".toUpper => Method{this: "hello", fn: toUpper(self)}
// string.toUpper => fn(self)