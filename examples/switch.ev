package main imports("io")

fn describeGrade(score) {
    switch {
    case score >= 90:
        return "A"
    case score >= 80:
        return "B"
    case score >= 70:
        return "C"
    default:
        return "F"
    }
}

fn describeDay(day) {
    switch day {
    case "monday", "tuesday", "wednesday", "thursday", "friday":
        return "weekday"
    case "saturday", "sunday":
        return "weekend"
    default:
        return "invalid"
    }
}

fn main() {
    io.println("Grade 95:", describeGrade(95))
    io.println("Grade 75:", describeGrade(75))
    io.println("Sunday:", describeDay("sunday"))
    io.println("Wednesday:", describeDay("wednesday"))
}
