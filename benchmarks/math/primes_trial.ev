// Trial division prime counting: nested loops, modulo, early returns.
// expect: 17984
package main

fn isPrime(n) {
    if n < 2 {
        return false
    }
    if n % 2 == 0 {
        return n == 2
    }
    var d := 3
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d += 2
    }
    return true
}

fn main() {
    var count := 0
    var n := 0
    while n < 200000 {
        if isPrime(n) {
            count += 1
        }
        n += 1
    }
    return count
}
